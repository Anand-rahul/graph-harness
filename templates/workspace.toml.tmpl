# graph-harness.toml — workspace configuration
# Lives at: <workspace_root>/.graph-harness/graph-harness.toml
# Generated by: graph-harness init
# Documented in: SPEC §11.1, SPEC §6.6 (sync), SPEC §9.1 (daemon)

[workspace]
# Stable identifier; used to derive the daemon socket / pipe path.
# Default: hash of the workspace absolute path.
id = "{{ .WorkspaceID }}"

[daemon]
# Idle-shutdown timeout. The daemon lazy-spawns on first CLI invocation
# (watchman-style) and exits after this many minutes of inactivity.
idle_timeout_minutes = 60

# Override the runtime directory for the pidfile + socket.
# Defaults: $XDG_RUNTIME_DIR (Linux), ~/Library/Application Support
# (macOS), %LOCALAPPDATA% (Windows).
# runtime_dir = ""

[event_log]
# SQLite WAL durability default for kernel writes. Critical writes
# (semantic.overlay imports, review.queue acceptances, high-severity
# findings) opt-in to FULL at the call site.
synchronous = "NORMAL"

# Global retention floor across all layers (SPEC §6.16). Per-layer
# compaction may keep more; this is the minimum.
retention_events = 100000
retention_days = 30

[snapshots]
# Per-layer retention is declared in each layer's manifest. This sets
# the kernel-wide cap on simultaneous snapshots kept on disk.
max_snapshots = 16

[sync]
# Per-layer sync mode is declared in each layer's manifest (SPEC §6.6).
# This block configures the team-mode peer when any layer opts in.
# peer_url = ""
# auth_token_file = ""

[studio]
# Studio binds loopback-only with a per-session token + strict Origin
# check (SPEC §9.6). Port 0 = ephemeral.
port = 0
open_browser = true

[mcp]
# Stdio transport in P0; HTTP/SSE deferred (SPEC §9.3).
transport = "stdio"
